<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/finly_background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="88dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_20"
            android:paddingTop="@dimen/spacing_20">

            <!-- Top Header & Notification Row -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tv_greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/finly_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="Good morning,\nJuan Dela Cruz! 👋" />

                <TextView
                    android:id="@+id/tv_student_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_greeting"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:textColor="@color/finly_text_secondary"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <FrameLayout
                    android:id="@+id/fl_notification_container"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/iv_notifications"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_notifications"
                        app:tint="@color/finly_blue" />

                    <View
                        android:id="@+id/v_notification_badge"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/badge_dot" />

                </FrameLayout>

            </RelativeLayout>

            <!-- Savings Overview Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_savings_overview"
                style="@style/Widget.Finly.Card.Elevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_20">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_20">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/savings_overview"
                            android:textColor="@color/finly_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:background="@drawable/badge_green"
                            android:paddingHorizontal="@dimen/spacing_12"
                            android:paddingVertical="@dimen/spacing_4"
                            android:text="@string/this_month"
                            android:textColor="@color/finly_green_dark"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </RelativeLayout>

                    <!-- Amounts & Circular Progress Container -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_16"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/total_savings"
                                android:textColor="@color/finly_text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tv_total_savings"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/finly_green"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                tools:text="₱ 3,500.00" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_8"
                                android:text="@string/total_target"
                                android:textColor="@color/finly_text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tv_total_target"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/finly_blue"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                tools:text="₱ 10,000.00" />

                        </LinearLayout>

                        <FrameLayout
                            android:layout_width="96dp"
                            android:layout_height="96dp">

                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/total_progress_circular"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:progress="35"
                                app:indicatorColor="@color/finly_green"
                                app:indicatorSize="96dp"
                                app:trackColor="@color/finly_blue_light"
                                app:trackThickness="8dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tv_total_progress_percent"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/finly_blue"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    tools:text="35%" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/saved_percent"
                                    android:textColor="@color/finly_text_secondary"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                        </FrameLayout>

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/spacing_16"
                        android:background="@color/finly_outline" />

                    <!-- Analytics Chart Header & Toggle -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_16"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Savings Analytics"
                            android:textColor="@color/finly_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/toggle_analytics_mode"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <Button
                                android:id="@+id/btn_chart_monthly"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:paddingHorizontal="@dimen/spacing_12"
                                android:text="Monthly"
                                android:textSize="11sp" />

                            <Button
                                android:id="@+id/btn_chart_plans"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:paddingHorizontal="@dimen/spacing_12"
                                android:text="By Plan"
                                android:textSize="11sp" />

                        </com.google.android.material.button.MaterialButtonToggleGroup>

                    </LinearLayout>

                    <!-- Interactive Analytics Chart View -->
                    <com.example.loginapp.AnalyticsChartView
                        android:id="@+id/analytics_chart_view"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginTop="@dimen/spacing_12" />

                    <!-- Metrics Summary Cards -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_16"
                        app:cardBackgroundColor="@color/finly_surface_variant"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/finly_outline"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="@dimen/spacing_12"
                            android:weightSum="3">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Avg / Month"
                                    android:textColor="@color/finly_text_secondary"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tv_avg_monthly_savings"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/finly_blue"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    tools:text="₱ 0.00" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Highest"
                                    android:textColor="@color/finly_text_secondary"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tv_highest_period"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/finly_green_dark"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    tools:text="₱ 0.00" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Goal Achieved"
                                    android:textColor="@color/finly_text_secondary"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tv_completion_rate"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/finly_blue"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    tools:text="0%" />

                            </LinearLayout>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/spacing_16"
                        android:background="@color/finly_outline" />

                    <!-- Streak Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_16"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:src="@android:drawable/ic_menu_myplaces"
                            app:tint="#F59E0B" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_8"
                            android:text="@string/current_streak"
                            android:textColor="@color/finly_text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tv_streak_days"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_4"
                            android:textColor="@color/finly_blue"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="7 Days" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_16"
                            android:background="@drawable/badge_green"
                            android:paddingHorizontal="@dimen/spacing_12"
                            android:paddingVertical="@dimen/spacing_4"
                            android:text="Keep It Up "
                            android:textColor="@color/finly_green_dark"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Active Savings Plans Container -->
            <LinearLayout
                android:id="@+id/layout_active_plans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_24">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/active_plans"
                        android:textColor="@color/finly_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="@string/see_all"
                        android:textColor="@color/finly_blue"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </RelativeLayout>

                <!-- Savings Goals RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_plans"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_12"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_saving_plan" />

                <!-- Add Savings Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_dashboard_add_saving"
                    style="@style/Widget.Finly.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height_primary"
                    android:layout_marginTop="@dimen/spacing_16"
                    android:text="@string/add_savings_btn"
                    app:icon="@android:drawable/ic_input_add"
                    app:iconGravity="textStart" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/finly_surface"
        app:elevation="8dp"
        app:itemIconTint="@color/finly_blue"
        app:itemRippleColor="@color/finly_blue_light"
        app:itemTextColor="@color/finly_blue"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
