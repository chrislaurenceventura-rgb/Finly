<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/finly_background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/finly_background"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/finly_background"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/finly_text_primary"
            app:title="@string/create_plan_title"
            app:titleCentered="true"
            app:titleTextColor="@color/finly_text_primary" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_20"
            android:paddingTop="@dimen/spacing_16"
            android:paddingBottom="@dimen/spacing_32">

            <!-- Form Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Finly.Card.Elevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_20">

                    <!-- Goal Name Field -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/goal_name_label"
                        android:textColor="@color/finly_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Finly.TextInputLayout.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_8">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_plan_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="e.g., Laptop / Tuition Fee"
                            android:inputType="textCapWords"
                            android:maxLines="1"
                            android:textColor="@color/finly_text_primary" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Target & Current Amounts Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_16"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/spacing_8"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/target_amount_label"
                                android:textColor="@color/finly_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.Finly.TextInputLayout.Outlined"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_8"
                                app:prefixText="₱ ">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/et_target_amount"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="numberDecimal"
                                    android:maxLines="1"
                                    android:textColor="@color/finly_text_primary" />

                            </com.google.android.material.textfield.TextInputLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_8"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/current_savings_label"
                                android:textColor="@color/finly_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.Finly.TextInputLayout.Outlined"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_8"
                                app:prefixText="₱ ">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/et_current_savings"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="numberDecimal"
                                    android:maxLines="1"
                                    android:textColor="@color/finly_text_primary" />

                            </com.google.android.material.textfield.TextInputLayout>

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Allowance Field -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_16"
                        android:text="@string/allowance_label"
                        android:textColor="@color/finly_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_allowance"
                        style="@style/Widget.Finly.TextInputLayout.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_8"
                        app:prefixText="₱ "
                        app:suffixText="/ week">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_allowance"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="e.g. 2500"
                            android:inputType="numberDecimal"
                            android:maxLines="1"
                            android:textColor="@color/finly_text_primary" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Dates Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_16"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/spacing_8"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/starting_date_label"
                                android:textColor="@color/finly_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.Finly.TextInputLayout.Outlined"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_8"
                                app:endIconDrawable="@android:drawable/ic_menu_today"
                                app:endIconMode="custom">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/et_start_date"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:clickable="true"
                                    android:focusable="false"
                                    android:textColor="@color/finly_text_primary" />

                            </com.google.android.material.textfield.TextInputLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_8"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/target_date_label"
                                android:textColor="@color/finly_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.Finly.TextInputLayout.Outlined"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_8"
                                app:endIconDrawable="@android:drawable/ic_menu_today"
                                app:endIconMode="custom">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/et_end_date"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:clickable="true"
                                    android:focusable="false"
                                    android:textColor="@color/finly_text_primary" />

                            </com.google.android.material.textfield.TextInputLayout>

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Frequency Selector -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_16"
                        android:text="@string/frequency_label"
                        android:textColor="@color/finly_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/tg_frequency"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_8"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <Button
                            android:id="@+id/btn_daily"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Daily"
                            android:textColor="@color/toggle_button_text"
                            app:backgroundTint="@color/toggle_button_background" />

                        <Button
                            android:id="@+id/btn_weekly"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Weekly"
                            android:textColor="@color/toggle_button_text"
                            app:backgroundTint="@color/toggle_button_background" />

                        <Button
                            android:id="@+id/btn_monthly"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Monthly"
                            android:textColor="@color/toggle_button_text"
                            app:backgroundTint="@color/toggle_button_background" />

                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <!-- Priority Selector -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_16"
                        android:text="@string/priority_label"
                        android:textColor="@color/finly_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/tg_priority"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_8"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <Button
                            android:id="@+id/btn_low"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Low"
                            android:textColor="@color/toggle_button_text"
                            app:backgroundTint="@color/toggle_button_background" />

                        <Button
                            android:id="@+id/btn_medium"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Medium"
                            android:textColor="@color/toggle_button_text"
                            app:backgroundTint="@color/toggle_button_background" />

                        <Button
                            android:id="@+id/btn_high"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="High"
                            android:textColor="@color/toggle_button_text"
                            app:backgroundTint="@color/toggle_button_background" />

                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <!-- Notes -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_16"
                        android:text="@string/notes_label"
                        android:textColor="@color/finly_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Finly.TextInputLayout.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_8">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_notes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine"
                            android:minLines="2"
                            android:textColor="@color/finly_text_primary" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Plan Preview Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Finly.Card.Elevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_20">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/plan_preview"
                        android:textColor="@color/finly_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_16"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/target_amount_label"
                                android:textColor="@color/finly_text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tv_preview_target"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/finly_blue"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                tools:text="₱ 0" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/current_savings_label"
                                android:textColor="@color/finly_text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tv_preview_current"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/finly_blue"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                tools:text="₱ 0" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/remaining_label"
                                android:textColor="@color/finly_text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tv_preview_remaining"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/finly_green_dark"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                tools:text="₱ 0" />

                        </LinearLayout>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_suggested_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/spacing_16"
                        android:textColor="@color/finly_text_secondary"
                        android:textSize="12sp"
                        tools:text="Suggested Weekly Savings" />

                    <TextView
                        android:id="@+id/tv_suggested_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/spacing_4"
                        android:textColor="@color/finly_green_dark"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:text="₱ 0.00" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Create Plan Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_create_plan"
                style="@style/Widget.Finly.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_primary"
                android:layout_marginTop="@dimen/spacing_24"
                android:text="@string/create_plan_btn" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
